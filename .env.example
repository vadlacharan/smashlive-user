# SmashLive Backend PayloadCMS API URL
# For local physical device testing over Wi-Fi, use your machine's LAN IP (e.g., http://192.168.31.51:3000)
# For production or deployed backend, use your domain (e.g., https://api.smashlive.app)
EXPO_PUBLIC_API_URL=http://localhost:3000
# Stripe publishable key (pk_live_... or pk_test_...) — public, safe to embed.
# Get it from Stripe Dashboard → Developers → API keys.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_xxx_YOUR_STRIPE_PUBLISHABLE_KEY_HERE

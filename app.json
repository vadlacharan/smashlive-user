{
  "expo": {
    "name": "SmashLive",
    "slug": "smashlive-user",
    "scheme": "smashlive",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "backgroundColor": "#0B0F0D",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.smashlive.user",
      "icon": "./assets/icon.png"
    },
    "android": {
      "package": "com.smashlive.user",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#0B0F0D",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SmashLive uses your location to show live distances to sports arenas, turfs, and tournaments near you."
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.smashlive.user"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d54a4762-e0a8-4f18-8c71-148c371aa9b2"
      }
    },
    "owner": "charanvadla27"
  }
}